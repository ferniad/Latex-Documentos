	keywords = {Photovoltaic systems, Optimization, particle swarm optimization, Particle swarm optimization, distributed photovoltaic, Distribution networks, Evaluation models, grid safety, hosting capacity assessment, iterative algorithm, Load modeling, Medium voltage, Safety, Transformers, Voltage},
	pages = {617--620},
	file = {Full Text PDF:/home/panchito/Zotero/storage/2ZZ8NCSA/Shen et al. - 2025 - An Improved Particle Swarm Optimization-Based Method for Assessing Distributed Photovoltaic Hosting.pdf:application/pdf},
}

@article{chang_equilibrium_2022,
	title = {Equilibrium {Optimizer}-{Based} {Approach} of {PV} {Generation} {Planning} in a {Distribution} {System} for {Maximizing} {Hosting} {Capacity}},
